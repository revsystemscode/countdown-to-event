<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CountdownToEvent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.CountdownToEvent.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- The stopwatch is white: give it the brand teal behind it on the splash. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.CountdownToEvent</item>
    </style>
</resources>
